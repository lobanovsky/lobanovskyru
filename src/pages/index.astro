---
import '../styles/global.css';
const services = [
  ['01', 'Автоматизация', 'Разбираемся, как устроены ваши процессы. Убираем ручную работу и связываем инструменты в одну систему.', 'Меньше рутины. Больше дела.'],
  ['02', 'Разработка', 'Создаём сервисы, мобильные приложения и сайты под задачи бизнеса. От первой идеи до работающего продукта.', 'Идея → продукт.'],
  ['03', 'Команды', 'Помогаем выстроить разработку: собрать сильную команду, наладить взаимодействие и двигаться к результату.', 'Люди, которым можно доверять.'],
];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Бюро Лобановского — автоматизация и разработка</title>
    <meta name="description" content="Автоматизируем бизнес, создаём сервисы, приложения и сайты. Помогаем строить сильные команды. Бюро Лобановского, Москва." />
    <link rel="canonical" href="https://lobanovsky.ru/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content="Бюро Лобановского" />
    <meta property="og:description" content="Меньше сложностей. Больше работающих решений. Автоматизация, разработка и команды." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://lobanovsky.ru/" />
    <meta name="theme-color" content="#f6f4ee" />
  </head>
  <body>
    <a class="skip" href="#main">Перейти к содержимому</a>
    <header class="container header">
      <a class="brand" href="/" aria-label="Бюро Лобановского, главная"><span class="mark" aria-hidden="true">л.</span><span>Бюро<br />Лобановского</span></a>
      <nav aria-label="Основная навигация"><a href="#work">Что делаем</a><a href="#products">Продукты</a><a class="nav-contact" href="#contact">Обсудить задачу <span aria-hidden="true">↗</span></a></nav>
    </header>
    <main id="main">
      <section class="container hero">
        <div class="eyebrow"><span class="dot"></span> Инженерный подход к бизнесу</div>
        <h1>Сложное<br />делаем <em>рабочим.</em></h1>
        <div class="hero-bottom"><p>Автоматизируем процессы, создаём цифровые продукты и собираем команды. Чтобы ваш бизнес двигался вперёд.</p><a class="button" href="#contact">Давайте познакомимся <span aria-hidden="true">↗</span></a></div>
        <div class="hero-note"><span>Москва · Работаем с задачами без границ</span><span>От идеи до ежедневной работы ↓</span></div>
      </section>
      <section class="services container" id="work" aria-labelledby="work-title">
        <div class="section-heading"><span class="eyebrow">01 / Что делаем</span><h2 id="work-title">Технологии с понятной пользой.</h2></div>
        <div class="cards">{services.map(([number, title, text, note]) => <article class="card"><span class="number">{number} /</span><h3>{title}</h3><p>{text}</p><div class="card-note">{note}</div></article>)}</div>
      </section>
      <section class="approach container" aria-labelledby="approach-title"><span class="eyebrow">Наш подход</span><div><h2 id="approach-title">Сначала — разобраться.<br />Потом — написать код.</h2><p>Начинаем с задачи, а не с выбора технологий. Обсуждаем, что мешает работе, определяем первый полезный результат и вместе выстраиваем путь к нему.</p></div></section>
      <section class="product-section" id="products" aria-labelledby="product-title"><div class="container product"><div class="product-copy"><span class="eyebrow">02 / Свой продукт</span><h2 id="product-title">Хорошие решения<br />бывают не только<br /><em>цифровыми.</em></h2><h3>Корзина Лобановского</h3><p>Постоянное чистое место для доставок у вашей двери. Простое решение, чтобы пакеты с продуктами больше не стояли на полу.</p><a class="text-link" href="https://basket.lobanovsky.ru">Познакомиться с корзиной <span aria-hidden="true">↗</span></a></div><div class="product-art" aria-hidden="true"><div class="art-label">БЮРО / ПРЕДМЕТЫ</div><div class="basket"><div class="basket-body"></div><div class="basket-leg left"></div><div class="basket-leg right"></div><div class="basket-shadow"></div></div><div class="art-caption"><span>Простая вещь.<br />Каждый день на своём месте.</span><span>№ 001</span></div></div></div></section>
      <section class="container contact" id="contact" aria-labelledby="contact-title"><span class="eyebrow">03 / Начнём с разговора</span><h2 id="contact-title">Что хотите<br /><em>сделать лучше?</em></h2><div class="contact-bottom"><p>Расскажите о своей задаче.<br />Вместе подумаем, как её решить.</p><div class="contact-links"><a class="button" href="https://t.me/e_lobanovsky">Написать в Telegram <span aria-hidden="true">↗</span></a><a href="mailto:e.lobanovsky@ya.ru">e.lobanovsky@ya.ru</a><a href="tel:+79267936363">+7 926 793-63-63</a></div></div></section>
    </main>
    <footer class="container footer"><span>© {new Date().getFullYear()} Бюро Лобановского</span><span>Внимание к задаче. Уважение к делу.</span><a href="#main">Наверх ↑</a></footer>
  </body>
</html>
