---
interface Props { kind: string; }
const { kind } = Astro.props;
---
<svg class={`project-art art-${kind}`} viewBox="0 0 480 250" fill="none" aria-hidden="true">
  {kind === 'trippip' && <>
    <path d="M55 183C115 183 95 65 188 65S273 192 342 157S360 60 430 60" stroke="currentColor" stroke-width="2" stroke-dasharray="5 7" />
    <circle cx="55" cy="183" r="8" fill="currentColor" /><circle cx="430" cy="60" r="8" stroke="currentColor" stroke-width="2" />
    <g transform="translate(148 77) rotate(-9 95 56)"><rect width="190" height="112" rx="8" fill="var(--paper)" stroke="currentColor" stroke-width="2"/><path d="M139 0V112" stroke="currentColor" stroke-dasharray="4 5"/><path d="m27 56 78-21-27 60-11-25-40-14Z" fill="currentColor"/><path d="m67 70 38-35" stroke="var(--paper)" stroke-width="2"/><path d="M156 30h16m-16 12h16m-16 12h16m-16 12h16m-16 12h16" stroke="currentColor" stroke-width="3"/></g>
    <text x="56" y="220" class="svg-label">ТОЧКА А</text><text x="370" y="35" class="svg-label">ТОЧКА Б</text>
  </>}
  {kind === 'tickets' && <>
    <path d="M70 56h340M70 67h340" stroke="currentColor" stroke-width="2"/><path d="M83 68v140l65-55V68M397 68v140l-65-55V68" fill="currentColor" opacity=".12"/><path d="M83 68v140l65-55V68M397 68v140l-65-55V68" stroke="currentColor" stroke-width="2"/>
    <rect x="147" y="91" width="188" height="100" rx="12" fill="var(--paper)" stroke="currentColor" stroke-width="2"/><circle cx="180" cy="122" r="12" fill="currentColor"/><path d="m174 122 4 4 8-8" stroke="var(--paper)" stroke-width="2"/><text x="205" y="127" class="svg-label">ЕСТЬ БИЛЕТЫ!</text><path d="M169 151h141m-141 13h92" stroke="currentColor" opacity=".3" stroke-width="3"/><path d="m323 66 6-16m9 24 15-7" stroke="currentColor" stroke-width="2"/>
  </>}
  {kind === 'housing' && <>
    <path d="M99 213h282M130 213V66h120v147M250 111h93v102" stroke="currentColor" stroke-width="2"/>
    {[85,119,153].map(y => <><rect x="150" y={y} width="20" height="18" fill="currentColor" opacity=".18"/><rect x="183" y={y} width="20" height="18" fill="currentColor" opacity=".18"/><path d={`M215 ${y}h17v18h-17z`} stroke="currentColor"/></>)}
    <path d="M178 213v-27h25v27M274 133h18v18h-18zm34 0h18v18h-18zm-34 34h18v18h-18zm34 0h18v18h-18z" stroke="currentColor" stroke-width="2"/><circle cx="322" cy="69" r="26" fill="var(--paper)" stroke="currentColor" stroke-width="2"/><path d="m311 69 8 8 15-17" stroke="currentColor" stroke-width="2"/>
  </>}
  {kind === 'parking' && <>
    <path d="M90 211h300M269 213l-13-102M312 213l13-102" stroke="currentColor" opacity=".3" stroke-width="2"/><rect x="122" y="133" width="32" height="78" rx="3" fill="var(--paper)" stroke="currentColor" stroke-width="2"/><circle cx="138" cy="151" r="5" fill="currentColor"/><g transform="rotate(-32 138 130)"><rect x="130" y="117" width="206" height="15" rx="3" fill="var(--paper)" stroke="currentColor" stroke-width="2"/>{[158,195,232,269,306].map(x => <path d={`m${x} 118 8 13`} stroke="currentColor" stroke-width="8"/>)}</g><path d="m273 73 14-14 14 14m-14-14v38" stroke="currentColor" stroke-width="2"/>
  </>}
  {kind === 'basket' && <>
    <path d="m143 94 42-38h114l39 38M143 94h195l-23 95H166l-23-95Z" fill="var(--paper)" stroke="currentColor" stroke-width="3"/><path d="m174 95 12 94m19-94 5 94m29-94v94m31-94-6 94m41-94-13 94M153 128h175m-167 30h160M182 190l-5 24m122-24 5 24" stroke="currentColor" stroke-width="2"/><path d="M202 57V42h74v15" stroke="currentColor" stroke-width="3"/><ellipse cx="240" cy="221" rx="99" ry="5" fill="currentColor" opacity=".08"/>
  </>}
  {kind === 'rita' && <>
    <path d="M240 59V43" stroke="currentColor" stroke-width="2"/><circle cx="240" cy="38" r="5" fill="currentColor"/><path d="m166 90-25 19 8 37 22-11m143-45 25 19-8 37-22-11" fill="currentColor" opacity=".2"/><rect x="169" y="61" width="142" height="105" rx="32" fill="var(--paper)" stroke="currentColor" stroke-width="2"/><circle cx="211" cy="109" r="7" fill="currentColor"/><circle cx="269" cy="109" r="7" fill="currentColor"/><path d="M225 134q15 15 30 0M208 169l-17 44h98l-17-44" stroke="currentColor" stroke-width="2"/><path d="m294 71 18-21 8 24-26-3Z" fill="currentColor"/><circle cx="202" cy="130" r="7" fill="currentColor" opacity=".15"/><circle cx="278" cy="130" r="7" fill="currentColor" opacity=".15"/><path d="M358 110v33m-16-16h33M113 57v21m-10-11h21" stroke="currentColor" stroke-width="2"/>
  </>}
</svg>
